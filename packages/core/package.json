{
  "name": "@reqseq/core",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recent-workspaces": {
      "types": "./dist/workspace/recent.d.ts",
      "default": "./dist/workspace/recent.js"
    },
    "./verification-degree": {
      "types": "./dist/evidence/degree-text.d.ts",
      "default": "./dist/evidence/degree-text.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build/code-fingerprint.mjs dist"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hast-util-to-mdast": "10.1.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.1",
    "micromark-extension-gfm": "3.0.0",
    "minisearch": "7.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@reqseq/testkit": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4"
  }
}
