{
  "name": "@reqseq/core",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-helper.*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./os-cache": {
      "types": "./dist/workspace/os-cache.d.ts",
      "default": "./dist/workspace/os-cache.js"
    },
    "./list-folder": {
      "types": "./dist/workspace/list-folder.d.ts",
      "default": "./dist/workspace/list-folder.js"
    },
    "./recent-workspaces": {
      "types": "./dist/workspace/recent.d.ts",
      "default": "./dist/workspace/recent.js"
    },
    "./verification-degree": {
      "types": "./dist/evidence/degree-text.d.ts",
      "default": "./dist/evidence/degree-text.js"
    },
    "./graph-words": {
      "types": "./dist/graph/words.d.ts",
      "default": "./dist/graph/words.js"
    },
    "./metamodel-graph": {
      "types": "./dist/metamodel/graph.d.ts",
      "default": "./dist/metamodel/graph.js"
    },
    "./criterion-items": {
      "types": "./dist/model/criterion-items.d.ts",
      "default": "./dist/model/criterion-items.js"
    },
    "./criterion-lines": {
      "types": "./dist/model/criterion-lines.d.ts",
      "default": "./dist/model/criterion-lines.js"
    },
    "./pasted-markdown": {
      "types": "./dist/reqif/pasted-markdown.d.ts",
      "default": "./dist/reqif/pasted-markdown.js"
    },
    "./command-error": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./docs-site": {
      "types": "./dist/docs-site/site.d.ts",
      "default": "./dist/docs-site/site.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build/code-fingerprint.mjs dist"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hast-util-to-mdast": "10.1.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.1",
    "micromark-extension-gfm": "3.0.0",
    "minisearch": "7.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@reqseq/testkit": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4"
  }
}
