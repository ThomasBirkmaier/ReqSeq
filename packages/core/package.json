{
  "name": "@reqseq/core",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.test-helper.*",
    "vendor/html-export/mermaid.js",
    "vendor/html-export/katex.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./installation": {
      "types": "./dist/installation.d.ts",
      "default": "./dist/installation.js"
    },
    "./os-cache": {
      "types": "./dist/workspace/os-cache.d.ts",
      "default": "./dist/workspace/os-cache.js"
    },
    "./list-folder": {
      "types": "./dist/workspace/list-folder.d.ts",
      "default": "./dist/workspace/list-folder.js"
    },
    "./recent-workspaces": {
      "types": "./dist/workspace/recent.d.ts",
      "default": "./dist/workspace/recent.js"
    },
    "./verification-degree": {
      "types": "./dist/evidence/degree-text.d.ts",
      "default": "./dist/evidence/degree-text.js"
    },
    "./displays": {
      "types": "./dist/displays/index.d.ts",
      "default": "./dist/displays/index.js"
    },
    "./graph-words": {
      "types": "./dist/graph/words.d.ts",
      "default": "./dist/graph/words.js"
    },
    "./metamodel-graph": {
      "types": "./dist/metamodel/graph.d.ts",
      "default": "./dist/metamodel/graph.js"
    },
    "./criterion-items": {
      "types": "./dist/model/criterion-items.d.ts",
      "default": "./dist/model/criterion-items.js"
    },
    "./pasted-markdown": {
      "types": "./dist/reqif/pasted-markdown.d.ts",
      "default": "./dist/reqif/pasted-markdown.js"
    },
    "./command-error": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./docs-site": {
      "types": "./dist/docs-site/site.d.ts",
      "default": "./dist/docs-site/site.js"
    },
    "./markdown": {
      "types": "./dist/html-export/markdown.d.ts",
      "default": "./dist/html-export/markdown.js"
    },
    "./render-options": {
      "types": "./dist/html-export/render-options.d.ts",
      "default": "./dist/html-export/render-options.js"
    },
    "./next-steps": {
      "types": "./dist/next-steps.d.ts",
      "default": "./dist/next-steps.js"
    },
    "./fold": {
      "types": "./dist/query/fold.d.ts",
      "default": "./dist/query/fold.js"
    },
    "./problem-titles": {
      "types": "./dist/problem-titles.d.ts",
      "default": "./dist/problem-titles.js"
    },
    "./suggested-key": {
      "types": "./dist/metamodel/suggested-key.d.ts",
      "default": "./dist/metamodel/suggested-key.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/build/code-fingerprint.mjs dist && node ../../scripts/build/html-export-vendor.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hast-util-to-mdast": "10.1.2",
    "katex": "0.19.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.2.1",
    "micromark-extension-gfm": "3.0.0",
    "minisearch": "7.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@reqseq/testkit": "workspace:*",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "happy-dom": "21.0.4",
    "mermaid": "11.17.2",
    "micromark-util-types": "2.0.3",
    "rolldown": "1.2.15"
  }
}
