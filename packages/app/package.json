{
  "name": "@logreq/app",
  "version": "0.0.0",
  "private": true,
  "productName": "LogReq",
  "description": "The LogReq desktop app: Electron shell over the command catalog (ADR-0010).",
  "type": "module",
  "main": "./out/main/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:electron": "electron-vite build",
    "electron:install": "node node_modules/electron/install.js",
    "start": "electron .",
    "test:electron": "pnpm electron:install && pnpm build:electron && playwright test --config test/playwright.config.ts"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@logreq/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@logreq/testkit": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "happy-dom": "21.0.4",
    "vite": "8.3.5"
  }
}
