{
  "name": "@logreq/app",
  "version": "0.0.0",
  "private": true,
  "productName": "LogReq",
  "description": "The LogReq desktop app: Electron shell over the command catalog (ADR-0010).",
  "type": "module",
  "main": "./out/main/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "build:electron": "electron-vite build",
    "electron:install": "node node_modules/electron/install.js",
    "start": "electron .",
    "test:electron": "pnpm electron:install && pnpm build:electron && playwright test --config test/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dagrejs/dagre": "3.1.1",
    "@leeoniya/ufuzzy": "1.0.19",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@logreq/core": "workspace:*",
    "katex": "0.19.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@logreq/testkit": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "happy-dom": "21.0.4",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "vite": "8.3.5"
  }
}
