* text=auto eol=lf
schemas/generated/** linguist-generated=true -diff
packages/core/src/generated/** linguist-generated=true -diff
# Architecture pictures, written by `pnpm docs:diagrams` (packages/docs/src/diagrams.ts).
docs/architecture/*.svg linguist-generated=true
pnpm-lock.yaml linguist-generated=true
# Version test vectors (ADR-0005) are byte-exact: no line-ending conversion, no whitespace fixes.
schemas/examples/version/** -text -whitespace
# JUnit files of SR-029 are enriched byte for byte: CRLF and the byte order mark must stay.
fixtures/SR-029/enrich/results/** -text -whitespace
# The JUnit file of the pytest example (SR-063) is a recording of the real pytest, kept byte for byte.
toolchain/junit/pytest/results.xml -text -whitespace
