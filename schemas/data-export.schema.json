{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logreq.dev/schemas/data-export.schema.json",
  "title": "Data of a state (Stand) as JSON",
  "description": "Output of `data.export` and the file written by `data.store` (SR-061, SR-062) for external evaluation tools such as Grafana or DuckDB (D-008). Also defines the element and relation shapes all commands return.",
  "type": "object",
  "required": ["logreq-data", "workspace", "generated", "repositories", "elements"],
  "properties": {
    "logreq-data": {
      "const": 1
    },
    "workspace": {
      "type": "string"
    },
    "generated": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "available"],
        "properties": {
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "commit": {
            "$ref": "common.schema.json#/$defs/commit"
          },
          "dirty": {
            "type": "boolean",
            "description": "Uncommitted changes to LogReq files."
          }
        },
        "additionalProperties": false
      }
    },
    "incomplete": {
      "$ref": "common.schema.json#/$defs/incomplete"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "shortId",
        "type",
        "status",
        "title",
        "version",
        "repository",
        "file",
        "properties",
        "relations"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "shortId": {
          "$ref": "common.schema.json#/$defs/shortId"
        },
        "type": {
          "$ref": "common.schema.json#/$defs/key"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/key"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Markdown body. Left out by list commands unless asked for."
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "versionDate": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Date of the version from Git; null when not committed yet (D-013: shown instead of the hash)."
        },
        "repository": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "description": "Path relative to the repository."
        },
        "readOnly": {
          "type": "boolean",
          "description": "Unknown type, invalid metamodel or read-only repository (SR-011 AK3, SR-016 AK3, SR-018 AK2)."
        },
        "validity": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          }
        },
        "emergent": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "All other properties by key, unknown ones included."
        },
        "relations": {
          "type": "array",
          "description": "The element's own relations, then the targets of its properties of kind `relation` (`property: true`). The targets of `validity` and `packages` also appear in `validity` and `packages` once data.export (SR-061) fills them.",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "verification": {
          "type": "array",
          "description": "Verification status per view: core and each variant the element is valid for (SR-047 AK3).",
          "items": {
            "type": "object",
            "required": ["view", "status"],
            "properties": {
              "view": {
                "$ref": "common.schema.json#/$defs/view"
              },
              "status": {
                "$ref": "common.schema.json#/$defs/verificationStatus"
              },
              "missingChildren": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/uuid"
                },
                "description": "SR-034 AK2."
              }
            },
            "additionalProperties": false
          }
        },
        "validation": {
          "$ref": "common.schema.json#/$defs/validationStatus"
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/problem"
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["kind", "direction", "id", "accessible", "targetState"],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/key",
          "description": "Key of the relation kind, or of the property of kind `relation` (e.g. `validity`, `packages`) that stores the target; such a property's targets also stay under `properties` as stored, and their entries have `property: true` and no `meaning`."
        },
        "property": {
          "const": true,
          "description": "`kind` is the key of a property of kind `relation`, not of a relation kind (ADR-0004). Left out for relation kinds."
        },
        "meaning": {
          "enum": ["derivation", "replacement", "exclusion", "reference", null],
          "description": "`reference` = inline link in the text (SR-066)."
        },
        "direction": {
          "enum": ["out", "in"]
        },
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "shortId": {
          "$ref": "common.schema.json#/$defs/shortId",
          "description": "Of the other end when it is available; of a target in a repository that is not on this machine with the prefix `UNKNOWN`, since its type is not known (SR-006 AK1, spec question #154)."
        },
        "title": {
          "type": "string",
          "description": "Only when the other end is available locally, also across repositories, where the file stores no title (SR-005 AK2, SR-006 AK1)."
        },
        "accessible": {
          "type": "boolean",
          "description": "`targetState` is `available`."
        },
        "targetState": {
          "enum": ["available", "inaccessible", "missing", "ambiguous", "unknown-repository"],
          "description": "Where the other end is (D-058): `available` = exactly one element with the UUID in the repository the relation names (the source's own when it names none); `inaccessible` = that repository is in the workspace file but not on this machine (N-041, SR-006); `missing` = the repository is here, the UUID is not in it (N-065, SR-089); `ambiguous` = several files there share the UUID (SR-088); `unknown-repository` = the workspace file lists no repository of that name, or `repository` is not text."
        },
        "storedVersion": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "currentVersion": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "outdated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
