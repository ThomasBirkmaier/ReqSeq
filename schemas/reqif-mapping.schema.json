{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqseq.dev/schemas/reqif-mapping.schema.json",
  "title": "ReqIF mapping file",
  "description": "Mapping of the types and attributes of one ReqIF source to the own metamodel, saved as YAML in the repository and reused for every later import from and export to that source (N-045, D-022, SR-054). The own metamodel is never changed by it (SR-054 AK3). Also holds saved export profiles (SR-059 AK3).",
  "type": "object",
  "required": ["logreq-reqif-mapping", "source"],
  "properties": {
    "logreq-reqif-mapping": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the source as written to the property with meaning `source` (SR-057, D-059)."
        },
        "tool-id": {
          "type": "string",
          "description": "REQ-IF-TOOL-ID seen in deliveries, for recognising the source."
        }
      },
      "additionalProperties": false
    },
    "target": {
      "$ref": "workspace.schema.json#/$defs/location",
      "description": "Folder where imported elements are written."
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "description": "LONG-NAME or IDENTIFIER of the SPEC-OBJECT-TYPE." },
          "type": { "$ref": "common.schema.json#/$defs/key" },
          "omit": { "const": true }
        },
        "oneOf": [{ "required": ["type"] }, { "required": ["omit"] }],
        "additionalProperties": false
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source-type": { "type": "string", "description": "Restricts the entry to one SPEC-OBJECT-TYPE." },
          "source": {
            "type": "string",
            "description": "LONG-NAME or IDENTIFIER of the ATTRIBUTE-DEFINITION."
          },
          "property": {
            "anyOf": [{ "enum": ["title", "text"] }, { "$ref": "common.schema.json#/$defs/key" }]
          },
          "values": {
            "type": "object",
            "additionalProperties": { "$ref": "common.schema.json#/$defs/key" },
            "description": "Enumeration value -> choice key."
          },
          "omit": { "const": true }
        },
        "oneOf": [{ "required": ["property"] }, { "required": ["omit"] }],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "properties": {
          "source": { "type": "string", "description": "LONG-NAME or IDENTIFIER of the SPEC-RELATION-TYPE." },
          "kind": { "$ref": "common.schema.json#/$defs/key" },
          "omit": { "const": true }
        },
        "oneOf": [{ "required": ["kind"] }, { "required": ["omit"] }],
        "additionalProperties": false
      }
    },
    "statement": {
      "description": "Where the statement (Stellungnahme) goes when exporting back to the source (SR-058).",
      "type": "object",
      "required": ["property", "attribute"],
      "properties": {
        "property": {
          "$ref": "common.schema.json#/$defs/key",
          "description": "Own property that holds the statement."
        },
        "attribute": { "type": "string", "description": "ATTRIBUTE-DEFINITION in the source's model." }
      },
      "additionalProperties": false
    },
    "export-profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "selection"],
        "properties": {
          "name": { "type": "string" },
          "selection": { "$ref": "common.schema.json#/$defs/selection" },
          "omit-properties": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/key" },
            "description": "SR-059 AK1."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
