{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logreq.dev/schemas/filter.schema.json",
  "title": "Saved filter file",
  "description": "A named filter saved as YAML in the repository (D-056, SR-070). The same condition language is the `where` of every command that takes a selection, so a saved filter gives the same elements in app, CLI, API and MCP (SR-070 AK3).",
  "type": "object",
  "required": ["logreq-filter", "name", "where"],
  "properties": {
    "logreq-filter": { "const": 1 },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique in the workspace; used to call the filter by name."
    },
    "description": { "type": "string" },
    "view": { "$ref": "common.schema.json#/$defs/view" },
    "where": { "$ref": "#/$defs/condition" },
    "sort": { "type": "array", "items": { "$ref": "#/$defs/sortKey" } }
  },
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "Combinable condition (SR-069). Exactly one operator per object.",
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "$ref": "#/$defs/keys" },
            "subtypes": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/keys" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["invalid"],
          "properties": {
            "invalid": { "type": "boolean", "description": "Status flagged invalid (D-044)." }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["package"],
          "properties": { "package": { "$ref": "common.schema.json#/$defs/elementRef" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["validFor"],
          "properties": { "validFor": { "$ref": "common.schema.json#/$defs/view" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["verification"],
          "properties": {
            "verification": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/verificationStatus" }
            },
            "variant": { "$ref": "common.schema.json#/$defs/view" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["validation"],
          "properties": {
            "validation": {
              "type": "array",
              "items": { "$ref": "common.schema.json#/$defs/validationStatus" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["emergent"],
          "properties": { "emergent": { "type": "boolean" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": {
              "type": "string",
              "description": "Value of the property with meaning `source` of imported elements (SR-057 AK2, D-059)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "description": "Full-text match as in search (SR-068)." }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/propertyCondition" },
        { "$ref": "#/$defs/relationCondition" }
      ]
    },
    "keys": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/key" } },
    "propertyCondition": {
      "type": "object",
      "required": ["property", "op"],
      "properties": {
        "property": { "$ref": "common.schema.json#/$defs/key" },
        "op": {
          "enum": ["eq", "ne", "in", "contains", "lt", "le", "gt", "ge", "exists", "missing", "matches"]
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "relationCondition": {
      "description": "Condition on relations, e.g. without child: {relation: {meaning: derivation, direction: down}, exists: false} (SR-069 AK3). Evidence is a relation direction too.",
      "type": "object",
      "required": ["relation", "exists"],
      "properties": {
        "relation": {
          "type": "object",
          "properties": {
            "kind": { "$ref": "common.schema.json#/$defs/key" },
            "meaning": { "enum": ["derivation", "replacement", "exclusion", "succession"] },
            "direction": {
              "enum": ["up", "down", "evidence"],
              "description": "`up` = outgoing (to parents), `down` = incoming (from children), `evidence` = records pointing at the element."
            },
            "to": { "$ref": "#/$defs/condition", "description": "Condition the other end must meet." }
          },
          "additionalProperties": false
        },
        "exists": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sortKey": {
      "description": "Sort by a property, the short ID, or the derivation hierarchy (SR-075). Nothing about order is ever stored in element files.",
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": {
          "anyOf": [
            { "enum": ["id", "hierarchy", "type", "status", "title"] },
            { "$ref": "common.schema.json#/$defs/key" }
          ]
        },
        "order": { "enum": ["asc", "desc"], "default": "asc" }
      },
      "additionalProperties": false
    }
  }
}
