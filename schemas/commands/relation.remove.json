{
  "name": "relation.remove",
  "title": "Remove relation",
  "summary": "Remove a relation from the source file.",
  "effect": "write-files",
  "whileReadOnly": "refuse",
  "whileReadOnlyReason": "Changes an element file, and no change can be checked against a missing or faulty metamodel.",
  "stage": 2,
  "implements": ["SR-067"],
  "arguments": [
    { "field": "source", "complete": "element" },
    { "field": "kind", "complete": "relation", "of": "source" },
    { "field": "target", "complete": "relation", "of": "kind" },
    { "field": "repository", "complete": "repository" }
  ],
  "input": {
    "type": "object",
    "properties": {
      "source": {
        "$ref": "../common.schema.json#/$defs/elementRef"
      },
      "kind": {
        "$ref": "../common.schema.json#/$defs/key"
      },
      "target": {
        "$ref": "../common.schema.json#/$defs/elementRef"
      },
      "repository": {
        "type": "string",
        "description": "Only relations into this repository (workspace name); a relation that names none points into the source's repository (D-058). Names the one meant when a UUID has relations into several repositories."
      }
    },
    "additionalProperties": false,
    "required": ["source", "kind", "target"]
  },
  "output": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "Written file, relative to the workspace root."
        }
      },
      "problems": {
        "type": "array",
        "items": {
          "$ref": "../common.schema.json#/$defs/problem"
        }
      }
    },
    "additionalProperties": false,
    "required": ["files"]
  }
}
