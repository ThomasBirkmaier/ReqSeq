{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logreq.dev/schemas/commands/catalog.meta.schema.json",
  "title": "Command catalog",
  "type": "object",
  "required": ["logreq-catalog", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "logreq-catalog": { "const": 1 },
    "description": { "type": "string" },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary", "effect", "stage", "implements", "input", "output"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]+\\.[a-z][A-Za-z]*$",
            "description": "group.action; CLI `logreq group action`, API `POST /v1/commands/group.action`, MCP tool `group_action`."
          },
          "summary": { "type": "string", "minLength": 10 },
          "effect": {
            "enum": ["read", "write-files"],
            "description": "No command writes to Git (D-036). No command deletes elements (D-045)."
          },
          "stage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "Stage of D-035 in which the command is built."
          },
          "implements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^SR-\\d{3}$" }
          },
          "input": { "type": "object" },
          "output": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "object" } },
            "description": "Outputs are JSON objects and say so at the root, also next to a `$ref`: MCP needs `type: object` at the root of an output schema (ADR-0009)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
