<?xml version="1.0" encoding="UTF-8"?>
<!-- Every datatype, an enumeration, two object types, relations, two specifications with a hierarchy, a relation group, and parts ReqSeq does not take over: an ALTERNATIVE-ID, THE-ORIGINAL-VALUE, a tool extension. -->
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="_hd-basic">
      <COMMENT>Hand-written sample</COMMENT>
      <CREATION-TIME>2026-10-31T00:00:00Z</CREATION-TIME>
      <REPOSITORY-ID>samples</REPOSITORY-ID>
      <REQ-IF-TOOL-ID>sample-tool</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>sample-tool 1</SOURCE-TOOL-ID>
      <TITLE>Customer A</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="dt-string" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="String" MAX-LENGTH="10000"/>
        <DATATYPE-DEFINITION-XHTML IDENTIFIER="dt-xhtml" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Text"/>
        <DATATYPE-DEFINITION-INTEGER IDENTIFIER="dt-integer" LAST-CHANGE="2026-10-31T00:00:00Z" MAX="1000" MIN="0"/>
        <DATATYPE-DEFINITION-REAL IDENTIFIER="dt-real" LAST-CHANGE="2026-10-31T00:00:00Z" ACCURACY="2" MAX="100" MIN="0"/>
        <DATATYPE-DEFINITION-DATE IDENTIFIER="dt-date" LAST-CHANGE="2026-10-31T00:00:00Z"/>
        <DATATYPE-DEFINITION-BOOLEAN IDENTIFIER="dt-boolean" LAST-CHANGE="2026-10-31T00:00:00Z"/>
        <DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="dt-priority" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Priority">
          <SPECIFIED-VALUES>
            <ENUM-VALUE IDENTIFIER="ev-high" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="High">
              <PROPERTIES><EMBEDDED-VALUE KEY="1" OTHER-CONTENT=""/></PROPERTIES>
            </ENUM-VALUE>
            <ENUM-VALUE IDENTIFIER="ev-low" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Low">
              <PROPERTIES><EMBEDDED-VALUE KEY="2" OTHER-CONTENT="lowest"/></PROPERTIES>
            </ENUM-VALUE>
          </SPECIFIED-VALUES>
        </DATATYPE-DEFINITION-ENUMERATION>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="ot-req" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ad-id" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="ID">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>dt-string</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="ad-text" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Description">
              <TYPE><DATATYPE-DEFINITION-XHTML-REF>dt-xhtml</DATATYPE-DEFINITION-XHTML-REF></TYPE>
            </ATTRIBUTE-DEFINITION-XHTML>
            <ATTRIBUTE-DEFINITION-INTEGER IDENTIFIER="ad-effort" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Effort">
              <TYPE><DATATYPE-DEFINITION-INTEGER-REF>dt-integer</DATATYPE-DEFINITION-INTEGER-REF></TYPE>
            </ATTRIBUTE-DEFINITION-INTEGER>
            <ATTRIBUTE-DEFINITION-REAL IDENTIFIER="ad-weight" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Weight">
              <TYPE><DATATYPE-DEFINITION-REAL-REF>dt-real</DATATYPE-DEFINITION-REAL-REF></TYPE>
            </ATTRIBUTE-DEFINITION-REAL>
            <ATTRIBUTE-DEFINITION-DATE IDENTIFIER="ad-due" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Due">
              <TYPE><DATATYPE-DEFINITION-DATE-REF>dt-date</DATATYPE-DEFINITION-DATE-REF></TYPE>
            </ATTRIBUTE-DEFINITION-DATE>
            <ATTRIBUTE-DEFINITION-BOOLEAN IDENTIFIER="ad-safety" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Safety">
              <TYPE><DATATYPE-DEFINITION-BOOLEAN-REF>dt-boolean</DATATYPE-DEFINITION-BOOLEAN-REF></TYPE>
            </ATTRIBUTE-DEFINITION-BOOLEAN>
            <ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="ad-priority" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Priority" MULTI-VALUED="false">
              <TYPE><DATATYPE-DEFINITION-ENUMERATION-REF>dt-priority</DATATYPE-DEFINITION-ENUMERATION-REF></TYPE>
            </ATTRIBUTE-DEFINITION-ENUMERATION>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-OBJECT-TYPE IDENTIFIER="ot-note" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Note">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ad-note" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Note text">
              <TYPE><DATATYPE-DEFINITION-STRING-REF>dt-string</DATATYPE-DEFINITION-STRING-REF></TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPEC-RELATION-TYPE IDENTIFIER="rt-refines" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Refines"/>
        <RELATION-GROUP-TYPE IDENTIFIER="gt-links" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Links"/>
        <SPECIFICATION-TYPE IDENTIFIER="st-doc" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Document"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="req-1" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Start">
          <ALTERNATIVE-ID><ALTERNATIVE-ID IDENTIFIER="A-1"/></ALTERNATIVE-ID>
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="A-1 &amp; more">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ad-id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML IS-SIMPLIFIED="true">
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>ad-text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div>The system <xhtml:b>shall</xhtml:b> start.</xhtml:div></THE-VALUE>
              <THE-ORIGINAL-VALUE><xhtml:div>The system <xhtml:b>shall</xhtml:b> start, <xhtml:u>underlined</xhtml:u>.</xhtml:div></THE-ORIGINAL-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-INTEGER THE-VALUE="5">
              <DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>ad-effort</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION>
            </ATTRIBUTE-VALUE-INTEGER>
            <ATTRIBUTE-VALUE-REAL THE-VALUE="0.5">
              <DEFINITION><ATTRIBUTE-DEFINITION-REAL-REF>ad-weight</ATTRIBUTE-DEFINITION-REAL-REF></DEFINITION>
            </ATTRIBUTE-VALUE-REAL>
            <ATTRIBUTE-VALUE-DATE THE-VALUE="2026-11-01T00:00:00Z">
              <DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>ad-due</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION>
            </ATTRIBUTE-VALUE-DATE>
            <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="true">
              <DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>ad-safety</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION>
            </ATTRIBUTE-VALUE-BOOLEAN>
            <ATTRIBUTE-VALUE-ENUMERATION>
              <DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ad-priority</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION>
              <VALUES><ENUM-VALUE-REF>ev-high</ENUM-VALUE-REF></VALUES>
            </ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>ot-req</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="req-2" LAST-CHANGE="2026-10-31T00:00:00Z">
          <TYPE><SPEC-OBJECT-TYPE-REF>ot-req</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="note-1" LAST-CHANGE="2026-10-31T00:00:00Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Only a note">
              <DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ad-note</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>ot-note</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPEC-RELATIONS>
        <SPEC-RELATION IDENTIFIER="rel-1" LAST-CHANGE="2026-10-31T00:00:00Z">
          <SOURCE><SPEC-OBJECT-REF>req-2</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>req-1</SPEC-OBJECT-REF></TARGET>
          <TYPE><SPEC-RELATION-TYPE-REF>rt-refines</SPEC-RELATION-TYPE-REF></TYPE>
        </SPEC-RELATION>
        <SPEC-RELATION IDENTIFIER="rel-2" LAST-CHANGE="2026-10-31T00:00:00Z">
          <SOURCE><SPEC-OBJECT-REF>note-1</SPEC-OBJECT-REF></SOURCE>
          <TARGET><SPEC-OBJECT-REF>req-1</SPEC-OBJECT-REF></TARGET>
          <TYPE><SPEC-RELATION-TYPE-REF>rt-refines</SPEC-RELATION-TYPE-REF></TYPE>
        </SPEC-RELATION>
      </SPEC-RELATIONS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="spec-a" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Requirements">
          <TYPE><SPECIFICATION-TYPE-REF>st-doc</SPECIFICATION-TYPE-REF></TYPE>
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="sh-1" LAST-CHANGE="2026-10-31T00:00:00Z">
              <OBJECT><SPEC-OBJECT-REF>req-1</SPEC-OBJECT-REF></OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="sh-2" LAST-CHANGE="2026-10-31T00:00:00Z">
                  <OBJECT><SPEC-OBJECT-REF>req-2</SPEC-OBJECT-REF></OBJECT>
                </SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
        <SPECIFICATION IDENTIFIER="spec-b" LAST-CHANGE="2026-10-31T00:00:00Z" LONG-NAME="Appendix">
          <TYPE><SPECIFICATION-TYPE-REF>st-doc</SPECIFICATION-TYPE-REF></TYPE>
        </SPECIFICATION>
      </SPECIFICATIONS>
      <SPEC-RELATION-GROUPS>
        <RELATION-GROUP IDENTIFIER="rg-1" LAST-CHANGE="2026-10-31T00:00:00Z">
          <RELATIONS><SPEC-RELATION-REF>rel-1</SPEC-RELATION-REF></RELATIONS>
          <SOURCE-SPECIFICATION><SPECIFICATION-REF>spec-a</SPECIFICATION-REF></SOURCE-SPECIFICATION>
          <TARGET-SPECIFICATION><SPECIFICATION-REF>spec-b</SPECIFICATION-REF></TARGET-SPECIFICATION>
          <TYPE><RELATION-GROUP-TYPE-REF>gt-links</RELATION-GROUP-TYPE-REF></TYPE>
        </RELATION-GROUP>
      </SPEC-RELATION-GROUPS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
  <TOOL-EXTENSIONS>
    <REQ-IF-TOOL-EXTENSION/>
  </TOOL-EXTENSIONS>
</REQ-IF>
