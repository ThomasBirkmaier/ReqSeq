{
  "name": "reqseq",
  "version": "0.4.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b packages/testkit packages/docs packages/core packages/core/test packages/cli packages/cli/test packages/api packages/mcp packages/app packages/app/test",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "schemas:check": "node scripts/contracts/validate-schemas.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:check": "node scripts/contracts/generate.mjs --check",
    "licenses:check": "node scripts/licenses/check.mjs",
    "merge:main": "node scripts/git/merge-main.mjs",
    "trace-check": "node scripts/trace-check/trace-check.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:delivery": "vitest run --config vitest.delivery.config.ts",
    "test:perf": "node -e \"const fs = require('node:fs'); for (const f of ['test-results/perf.jsonl', 'test-results/junit-perf.xml']) fs.rmSync(f, { force: true })\" && vitest run --config vitest.perf.config.ts",
    "perf:report": "node scripts/perf/report.mjs",
    "reqseq": "node packages/cli/dist/bin.js",
    "spec:check": "node packages/cli/dist/bin.js workspace check --workspace spec",
    "docs:generate": "pnpm --filter \"@reqseq/docs...\" build && node packages/docs/dist/bin.js",
    "docs:install": "pnpm install --dir packages/docs/site --ignore-workspace --frozen-lockfile --ignore-scripts",
    "docs:build": "pnpm docs:generate && pnpm docs:install && node packages/docs/site/run.mjs build",
    "docs:dev": "pnpm docs:generate && node packages/docs/site/run.mjs dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "mermaid>katex": "0.19.0"
    }
  }
}
