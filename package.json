{
  "name": "logreq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b packages/testkit packages/core packages/cli packages/cli/test packages/api packages/mcp packages/app",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "schemas:check": "node scripts/contracts/validate-schemas.mjs",
    "contracts:generate": "node scripts/contracts/generate.mjs",
    "contracts:check": "node scripts/contracts/generate.mjs --check",
    "licenses:check": "node scripts/licenses/check.mjs",
    "trace-check": "node scripts/trace-check/trace-check.mjs",
    "spec-export:convert": "node scripts/spec-export/convert.mjs scripts/spec-export/raw spec",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
